# Cloudflare Pages response headers.
# Keep the app shell revalidated so a new deploy shows up immediately (the data JSON
# is already fetched with cache:'no-store'). Hashed assets can stay cacheable.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
# Data JSON must always revalidate — it's the freshness the whole app reads from.
/data/*
  Cache-Control: no-cache
